# Nemotron via NVIDIA NIM — the classifier and the notes agent.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# ElevenLabs — Scribe v2 realtime in, TTS out.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The front desk and the researchers run on the Claude Agent SDK, which drives
# the `claude` CLI. Either `claude login` on this machine, or set:
# ANTHROPIC_API_KEY=

# Model aliases for the SDK sessions (empty = the CLI default).
HEARD_FRONTDESK_MODEL=
HEARD_RESEARCH_MODEL=
HEARD_FRONTDESK_EFFORT=low
HEARD_RESEARCH_EFFORT=low

# Providers: auto | elevenlabs | browser | off
HEARD_STT=auto
HEARD_TTS=auto

# Clocks and the harness (seconds).
HEARD_CLASSIFY_FLOOR_S=2
HEARD_CLASSIFY_CEILING_S=5
HEARD_NOTES_EVERY_S=20
HEARD_ASKED_WINDOW_S=20
HEARD_UNSOLICITED_GAP_S=90
HEARD_FLOOR_GAP_S=0.8
HEARD_FLOOR_TIMEOUT_S=15
HEARD_MAX_RESEARCH=3
